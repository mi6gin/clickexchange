# Окружение (production | development)
DJANGO_ENV=production

# Секретный ключ Django. Сгенерировать:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CHANGE_ME

# Хосты через запятую
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=clickexchange
POSTGRES_USER=clicker
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (кэш и channel layers для WebSocket)
REDIS_URL=redis://redis:6379/1
CHANNEL_LAYER_URL=redis://redis:6379/2

# Celery
CELERY_BROKER_URL=redis://redis:6379/0

# Gunicorn
GUNICORN_WORKERS=2

# Опционально: авто-создание суперпользователя при старте
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
